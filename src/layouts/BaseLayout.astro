---
import '@/styles/global.css'; 
import { SITE_TITLE as DEFAULT_SITE_TITLE, SITE_DESCRIPTION as DEFAULT_SITE_DESCRIPTION } from '@/consts';
import AboutModal from '@/components/AboutModal.astro';
import OtherOrganizationsModal from '@/components/OtherOrganizationsModal.astro'; // <-- IMPORT nowego modala

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = DEFAULT_SITE_TITLE,
  description = DEFAULT_SITE_DESCRIPTION,
} = Astro.props;
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    
    <link rel="stylesheet" href="/node_modules/@fortawesome/fontawesome-free/css/all.min.css" />
  </head>
  <body class="flex flex-col min-h-screen bg-gray-100 text-gray-800 font-sans">
    <slot name="header" />
    <main class="flex-grow w-full">
      <slot />
    </main>
    <slot name="footer" />
    
    <AboutModal />
    <OtherOrganizationsModal /> {/* <-- DODAJ nowy modal tutaj */}
  </body>
</html>