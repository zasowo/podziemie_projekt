---
import '@/styles/global.css'; 
import { SITE_TITLE as DEFAULT_SITE_TITLE, SITE_DESCRIPTION as DEFAULT_SITE_DESCRIPTION } from '@/consts';
import AboutModal from '@/components/AboutModal.astro'; // Ensure AboutModal is imported

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = DEFAULT_SITE_TITLE,
  description = DEFAULT_SITE_DESCRIPTION,
} = Astro.props;
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} - {DEFAULT_SITE_TITLE}</title> {/* Changed to use DEFAULT_SITE_TITLE here too */}
    
    <link rel="stylesheet" href="/node_modules/@fortawesome/fontawesome-free/css/all.min.css" />
  </head>
  <body class="flex flex-col min-h-screen bg-gray-100 text-gray-800 font-sans">
    <slot name="header" /> {/* Header is slotted in */}
    <main class="flex-grow w-full">
      <slot /> {/* Individual page content */}
    </main>
    <slot name="footer" /> {/* Footer is slotted in */}
    
    <AboutModal /> {/* AboutModal instance for global availability */}
  </body>
</html>