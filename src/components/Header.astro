---
import { SITE_TITLE } from '@/consts'; // SITE_TITLE to "Podziemie"
const user = Astro.locals.user; // Dostęp do danych użytkownika z middleware

// Zaktualizowane linki nawigacyjne
const navLinks = [
  // "Częstochowa" jest obsługiwana osobno dla wyróżnienia
  { href: "/artykuly", text: "Zasoby" }, // Zmieniono z "Odkrywaj", href wskazuje na listę artykułów
  // "Inne Organizacje" i "O Projekcie" są teraz przyciskami otwierającymi modale
];
---
<header class="bg-white shadow-sm hero-pattern sticky top-0 z-50">
  <div class="container mx-auto px-4 py-4">
    <div class="flex justify-between items-center">
      {/* Sekcja Logo - Zaktualizowana Ikona i Czcionka dla SITE_TITLE */}
      <a 
        href="/" 
        class="group flex items-center space-x-2.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2 focus-visible:ring-offset-white rounded-sm"
        aria-label="Strona główna Patrimonium"
      >
        <div class="w-10 h-10 bg-red-600 rounded-full flex items-center justify-center transition-transform duration-300 ease-in-out group-hover:scale-110 group-hover:shadow-lg">
          <i class="fas fa-flag text-white text-lg"></i> {/* Zmieniona ikona na fa-flag */}
        </div>
        {/* Ten h1 użyje czcionki Lora (font-serif) z global.css lub tailwind.config.mjs */}
        <h1 class="text-2xl font-bold text-gray-800 transition-colors duration-300 ease-in-out group-hover:text-red-700 font-serif">
          {SITE_TITLE}
        </h1>
      </a>
      
      {/* Centrum: Linki Nawigacyjne - Zwiększone odstępy, wyrównanie do linii bazowej */}
      <nav class="hidden md:flex items-baseline space-x-6 lg:space-x-8"> {/* Zwiększone odstępy */}
        {/* Wyróżniony Link "Częstochowa" - Usunięto podświetlenie */}
        <a 
          href="/region/czestochowa"  
          class="nav-link text-red-600 hover:text-red-700 font-semibold transition-colors duration-150 whitespace-nowrap text-lg pb-0.5"
          aria-current={Astro.url.pathname === '/region/czestochowa' || Astro.url.pathname === '/' ? 'page' : undefined} 
          style="" 
        >
          Częstochowa
        </a>
        {navLinks.map(link => (
          <a 
            href={link.href} 
            class="nav-link text-gray-700 hover:text-red-600 font-medium transition-colors duration-150 whitespace-nowrap pt-0.5" 
            aria-current={Astro.url.pathname.startsWith(link.href) ? 'page' : undefined}
          >
            {link.text}
          </a>
        ))}
        <button 
          id="header-other-orgs-button"
          type="button"
          class="nav-link text-gray-700 hover:text-red-600 font-medium transition-colors duration-150 whitespace-nowrap pt-0.5"
        >
          Inne Organizacje
        </button>
        <button 
          id="header-about-button"
          type="button"
          class="nav-link text-gray-700 hover:text-red-600 font-medium transition-colors duration-150 whitespace-nowrap pt-0.5"
        >
          O Projekcie
        </button>
      </nav>
      
      {/* Prawo: Akcje autoryzacji i Przełącznik Menu Mobilnego - Zwiększone odstępy */}
      <div class="flex items-center space-x-4 md:space-x-5"> {/* Zwiększone odstępy */}
        {/* Kontener dla elementów autoryzacji */}
        <div class="flex items-center space-x-3 md:space-x-4" style="min-width: auto; justify-content: flex-end;">
          {user ? (
            <>
              <span class="hidden sm:inline text-sm text-gray-600 whitespace-nowrap">
                Witaj, {user.name || user.email}!
              </span>
              {user.role === 'admin' && (
                <a href="/admin" class="px-2.5 py-1 text-xs bg-yellow-400 text-yellow-900 rounded hover:bg-yellow-500 transition font-medium whitespace-nowrap">
                  Panel Admina
                </a>
              )}
              <a href="/user/profile" class="nav-link text-gray-700 hover:text-red-600 text-sm font-medium whitespace-nowrap">
                Mój Profil
              </a>
              <button 
                id="signout-button"
                type="button"
                class="px-3 py-1.5 text-xs bg-red-600 text-white rounded-md hover:bg-red-700 transition font-medium whitespace-nowrap"
              >
                Wyloguj
              </button>
            </>
          ) : (
            <a href="/user/signin" class="px-4 py-2 bg-red-600 text-white rounded-md hover:bg-red-700 transition text-sm font-medium whitespace-nowrap">
              Zaloguj się
            </a>
          )}
        </div>
        <button id="mobile-menu-button" class="md:hidden text-gray-700 p-2 focus:outline-none focus:ring-2 focus:ring-red-500 rounded">
          <i class="fas fa-bars text-xl"></i>
        </button>
      </div>
    </div>
  </div>

  {/* Menu Mobilne */}
  <div id="mobile-menu" class="md:hidden hidden bg-white shadow-lg py-2">
    <a href="/region/czestochowa" class="block px-4 py-2 text-red-600 hover:bg-red-50 font-semibold">Częstochowa</a>
    {navLinks.map(link => (
      <a 
        href={link.href} 
        class="block px-4 py-2 text-gray-700 hover:bg-red-50 hover:text-red-600"
        aria-current={Astro.url.pathname.startsWith(link.href) ? 'page' : undefined}
      >
        {link.text}
      </a>
    ))}
    <button id="mobile-header-other-orgs-button" type="button" class="w-full text-left block px-4 py-2 text-gray-700 hover:bg-red-50 hover:text-red-600">Inne Organizacje</button>
    <button id="mobile-header-about-button" type="button" class="w-full text-left block px-4 py-2 text-gray-700 hover:bg-red-50 hover:text-red-600">O Projekcie</button>
    <hr class="my-1 border-gray-200" />
    {user ? (
      <>
        {user.role === 'admin' && (
            <a href="/admin" class="block px-4 py-2 text-yellow-700 bg-yellow-100 hover:bg-yellow-200 font-medium">Panel Admina</a>
        )}
        <a href="/user/profile" class="block px-4 py-2 text-gray-700 hover:bg-red-50 hover:text-red-600">Mój Profil</a>
        <button 
          id="mobile-signout-button"
          type="button"
          class="w-full text-left block px-4 py-2 text-gray-700 hover:bg-red-50 hover:text-red-600"
        >
          Wyloguj
        </button>
      </>
    ) : (
       <a href="/user/signin" class="block px-4 py-2 text-gray-700 hover:bg-red-50 hover:text-red-600">Zaloguj się</a>
     )}
  </div>
</header>

<script>
  import { authClient } from '@/auth-client';

  // --- Przełącznik Menu Mobilnego ---
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  menuButton?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  // --- Logika Wylogowania (Desktop i Mobilne) ---
  const signoutButton = document.getElementById('signout-button');
  signoutButton?.addEventListener('click', async () => {
    const result = await authClient.signOut();
    if (result && !result.error) {
      window.location.href = '/'; 
    } else {
      console.error('Wylogowanie (desktop) nie powiodło się:', result?.error);
      alert('Wylogowanie nie powiodło się. Spróbuj ponownie.');
    }
  });

  const mobileSignoutButton = document.getElementById('mobile-signout-button');
  mobileSignoutButton?.addEventListener('click', async () => {
    const result = await authClient.signOut();
    if (result && !result.error) {
      window.location.href = '/';
    } else {
      console.error('Wylogowanie (mobilne) nie powiodło się:', result?.error);
      alert('Wylogowanie nie powiodło się. Spróbuj ponownie.');
    }
  });
  
  // --- Wyzwalacz Modala "O Projekcie" ---
  const headerAboutButton = document.getElementById('header-about-button');
  headerAboutButton?.addEventListener('click', () => {
    if (typeof (window as any).openAboutModal === 'function') {
      (window as any).openAboutModal();
    } else {
      console.error('Nie znaleziono funkcji openAboutModal (desktop).');
      alert('Funkcja "O Projekcie" jest tymczasowo niedostępna.');
    }
  });
  
  const mobileHeaderAboutButton = document.getElementById('mobile-header-about-button');
  mobileHeaderAboutButton?.addEventListener('click', () => {
    if (typeof (window as any).openAboutModal === 'function') {
      (window as any).openAboutModal();
      mobileMenu?.classList.add('hidden'); 
    } else {
      console.error('Nie znaleziono funkcji openAboutModal (mobilne).');
      alert('Funkcja "O Projekcie" jest tymczasowo niedostępna.');
    }
  });

  // --- Wyzwalacz Modala "Inne Organizacje" ---
  const headerOtherOrgsButton = document.getElementById('header-other-orgs-button');
  headerOtherOrgsButton?.addEventListener('click', () => {
    if (typeof (window as any).openOtherOrgsModal === 'function') {
      (window as any).openOtherOrgsModal();
    } else {
      console.error('Nie znaleziono funkcji openOtherOrgsModal (desktop).');
      alert('Funkcja "Inne Organizacje" jest tymczasowo niedostępna.');
    }
  });
  const mobileHeaderOtherOrgsButton = document.getElementById('mobile-header-other-orgs-button');
  mobileHeaderOtherOrgsButton?.addEventListener('click', () => {
    if (typeof (window as any).openOtherOrgsModal === 'function') {
      (window as any).openOtherOrgsModal();
      mobileMenu?.classList.add('hidden');
    } else {
      console.error('Nie znaleziono funkcji openOtherOrgsModal (mobilne).');
      alert('Funkcja "Inne Organizacje" jest tymczasowo niedostępna.');
    }
  });
</script>