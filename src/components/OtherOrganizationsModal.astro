---
// src/components/OtherOrganizationsModal.astro
import { allOrganizationCategories } from '@/lib/organizations'; // Importujemy dane z jednego, spójnego źródła
---
<div 
  id="other-orgs-modal-overlay"
  aria-modal="true"
  role="dialog"
  aria-labelledby="other-orgs-modal-title"
  class="fixed inset-0 bg-black/60 z-[70] flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-300 ease-in-out backdrop-blur-sm"
>
  <div 
    id="other-orgs-modal-panel"
    class="bg-white rounded-xl w-full max-w-2xl mx-auto p-6 shadow-2xl transform scale-95 transition-transform duration-300 ease-in-out"
  >
    {/* Nagłówek Modala */}
    <div class="flex justify-between items-center mb-5 pb-4 border-b border-gray-200">
      <div class="flex items-center gap-3">
        <i class="fas fa-sitemap text-xl text-red-600"></i>
        <h3 id="other-orgs-modal-title" class="text-xl lg:text-2xl font-semibold text-gray-800">
          Inne Organizacje Opozycyjne
        </h3>
      </div>
      <button 
        id="other-orgs-modal-close-icon"
        type="button"
        class="text-gray-500 hover:text-red-600 p-1 -m-1 transition-colors" 
        aria-label="Zamknij modal"
      >
        <i class="fas fa-times text-2xl"></i>
      </button>
    </div>

    {/* Treść Modala */}
    <div class="text-gray-700 text-sm max-h-[65vh] overflow-y-auto modal-content-scroll pr-3 space-y-5">
      <p class="text-gray-600 text-base leading-relaxed">
        Poniżej znajduje się lista wybranych organizacji opozycyjnych działających w okresie PRL. Możesz przejść do archiwum publikacji danej organizacji lub zapoznać się z jej historią na Wikipedii.
      </p>
      
      <ul class="space-y-4">
        {allOrganizationCategories.map(org => (
          <li>
            {/* Zmieniono układ na flex dla lepszego wyrównania na różnych ekranach */}
            <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-3 bg-gray-50 p-4 rounded-lg border border-gray-200/80">
              <h4 class="text-md sm:text-lg font-semibold text-gray-800 text-left">{org.name}</h4>
              {/* Kontener na przyciski */}
              <div class="flex items-center space-x-2 shrink-0">
                {/* NOWY PRZYCISK: Link do archiwum na stronie */}
                <a
                  href={`/organizacje/${org.slug}`}
                  class="inline-flex items-center px-3 py-1.5 text-xs font-medium text-white bg-red-600 rounded-md hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-1 focus:ring-red-500 transition"
                  title={`Zobacz archiwum dla: ${org.name}`}
                >
                  Zobacz Archiwum
                </a>
                {/* Istniejący link do Wikipedii */}
                <a 
                  href={org.wikipediaLink} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="inline-flex items-center px-3 py-1.5 text-xs text-sky-600 border border-sky-400/50 rounded-md hover:bg-sky-600 hover:text-white hover:border-sky-600 transition-all duration-200 ease-in-out font-medium"
                  title={`Przeczytaj o ${org.name} na Wikipedii`}
                >
                  Wikipedia <i class="fas fa-external-link-alt ml-1.5 text-xs"></i>
                </a>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>

    {/* Stopka Modala */}
    <div class="mt-8 pt-4 border-t border-gray-200 text-right">
      <button 
        id="other-orgs-modal-close-button"
        type="button"
        class="px-6 py-2 bg-gray-200 text-gray-800 rounded-lg hover:bg-gray-300 transition font-medium text-sm focus:outline-none focus:ring-2 focus:ring-gray-400 focus:ring-offset-2"
      >
        Zamknij
      </button>
    </div>
  </div>
</div>

<script>
  // Skrypt pozostaje bez zmian, jego logika jest poprawna
  const modalOverlayOrgs = document.getElementById('other-orgs-modal-overlay') as HTMLElement;
  const modalPanelOrgs = document.getElementById('other-orgs-modal-panel') as HTMLElement;
  const closeIconOrgs = document.getElementById('other-orgs-modal-close-icon');
  const closeButtonOrgs = document.getElementById('other-orgs-modal-close-button');

  function openOtherOrgsModal() {
    if (modalOverlayOrgs && modalPanelOrgs) {
      modalOverlayOrgs.classList.remove('opacity-0', 'pointer-events-none');
      modalOverlayOrgs.classList.add('opacity-100');
      modalPanelOrgs.classList.remove('scale-95');
      modalPanelOrgs.classList.add('scale-100');
      document.body.style.overflow = 'hidden';
      document.addEventListener('keydown', handleEscapeKeyOrgs);
    }
  }

  function closeOtherOrgsModal() {
    if (modalOverlayOrgs && modalPanelOrgs) {
      modalOverlayOrgs.classList.add('opacity-0');
      modalOverlayOrgs.classList.remove('opacity-100');
      modalPanelOrgs.classList.add('scale-95');
      modalPanelOrgs.classList.remove('scale-100');
      setTimeout(() => {
        modalOverlayOrgs.classList.add('pointer-events-none');
      }, 300); 
      document.body.style.overflow = 'unset';
      document.removeEventListener('keydown', handleEscapeKeyOrgs);
    }
  }

  function handleEscapeKeyOrgs(event: KeyboardEvent) {
    if (event.key === 'Escape') {
      closeOtherOrgsModal();
    }
  }

  modalOverlayOrgs?.addEventListener('click', (event) => {
    if (event.target === modalOverlayOrgs) {
      closeOtherOrgsModal();
    }
  });

  closeIconOrgs?.addEventListener('click', closeOtherOrgsModal);
  closeButtonOrgs?.addEventListener('click', closeOtherOrgsModal);

  (window as any).openOtherOrgsModal = openOtherOrgsModal;
</script>

<style is:global>
  /* Styl dla paska przewijania modala */
  .modal-content-scroll::-webkit-scrollbar { width: 6px; }
  .modal-content-scroll::-webkit-scrollbar-track { background: #f1f1f1; border-radius: 10px; }
  .modal-content-scroll::-webkit-scrollbar-thumb { background: #c5c5c5; border-radius: 10px; }
  .modal-content-scroll::-webkit-scrollbar-thumb:hover { background: #a0a0a0; }
</style>