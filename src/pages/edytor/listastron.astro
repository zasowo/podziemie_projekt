---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { getUserPages, getAllPages, type Page } from "@/lib/pagedb";
import { SITE_TITLE } from '@/consts';

let pages: Page[] = [];

const user = Astro.locals.user;
const role = Astro.locals.role;

if (role === "admin") {
  pages = await getAllPages();
} else if (user && (role === "edytor")) {
  pages = await getUserPages(user.id);
}

if (!user || (role !== 'admin' && role !== 'edytor')) {
  return Astro.redirect('/user/signin?error=EditorAccessRequired');
}

function formatDate(dateString: Date | string | undefined) {
  if (!dateString) return 'N/A';
  return new Date(dateString).toLocaleDateString('pl-PL', {
    year: 'numeric', month: 'long', day: 'numeric',
    hour: '2-digit', minute: '2-digit'
  });
}
---
<BaseLayout title={`Zarządzanie Stronami - ${SITE_TITLE}`}>
  <Header slot="header" />

  <div class="container mx-auto px-4 py-8 sm:py-12">
    <header class="mb-8 flex flex-col sm:flex-row justify-between items-center gap-4">
      <div>
        <h1 class="text-3xl sm:text-4xl font-bold text-gray-800">Zarządzanie Stronami</h1>
        <p class="text-gray-600 mt-1">Przeglądaj, edytuj lub usuń istniejące publikacje.</p>
      </div>
      <a href="/edytor/dodaj" class="px-5 py-2.5 text-sm font-medium text-white bg-red-600 rounded-lg hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition whitespace-nowrap">
        <i class="fas fa-plus mr-2"></i>Dodaj Nową Stronę
      </a>
    </header>

    {pages && pages.length > 0 ? (
      <div class="bg-white rounded-xl shadow-xl overflow-hidden">
        <ul class="divide-y divide-gray-200">
          {pages.map(page => (
            <li class="p-4 sm:p-6 hover:bg-gray-50/70 transition-colors duration-150">
              <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                <div class="flex-grow min-w-0"> 
                  <h2 class="text-lg sm:text-xl font-semibold text-gray-800 truncate">
                    <a href={`/${page.slug}`} class="hover:text-red-700 hover:underline" title={`Zobacz stronę: ${page.title}`}>
                      {page.title}
                    </a>
                  </h2>
                  <p class="text-xs text-gray-500 mt-0.5">
                    <span class="font-medium">Adres:</span> /{page.slug}
                  </p>
                  <p class="text-xs text-gray-500 mt-1">
                    <span class="font-medium">Utworzono:</span> {formatDate(page.createdAt)}
                    </p>
                </div>
                <div class="flex items-center space-x-2 sm:space-x-3 shrink-0 mt-3 sm:mt-0">
                  <a 
                    href={`/edytor/edit/${page.slug}`} 
                    class="px-3 py-1.5 text-xs font-medium text-white bg-sky-600 rounded-md hover:bg-sky-700 focus:outline-none focus:ring-2 focus:ring-offset-1 focus:ring-sky-500 transition whitespace-nowrap"
                    title="Edytuj stronę"
                  >
                    <i class="fas fa-pencil-alt mr-1 sm:mr-1.5"></i>Edytuj
                  </a>
                  <button 
                    type="button"
                    class="delete-link px-3 py-1.5 text-xs font-medium text-white bg-red-600 rounded-md hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-1 focus:ring-red-500 transition whitespace-nowrap"
                    data-slug={page.slug}
                    data-title={page.title}
                    title="Usuń stronę"
                  >
                    <i class="fas fa-trash-alt mr-1 sm:mr-1.5"></i>Usuń
                  </button>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>
    ) : (
      <div class="text-center py-16 bg-white rounded-xl shadow-lg">
        <i class="fas fa-folder-open text-6xl text-gray-300 mb-5"></i>
        <h2 class="text-xl font-semibold text-gray-700 mb-2">Brak Stron do Wyświetlenia</h2>
        <p class="text-gray-500 text-sm mb-6 max-w-md mx-auto">
          {role === 'admin' ? 
            "Nie dodano jeszcze żadnych stron do systemu. Kliknij poniżej, aby utworzyć pierwszą." : 
            "Nie utworzyłeś jeszcze żadnych stron. Rozpocznij dodając nową publikację."
          }
        </p>
        <a href="/edytor/dodaj" class="px-6 py-3 text-sm font-medium text-white bg-red-600 rounded-lg hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition">
          Utwórz Pierwszą Stronę
        </a>
      </div>
    )}
  </div>

  <Footer slot="footer" />
</BaseLayout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const deleteLinks = document.querySelectorAll<HTMLButtonElement>(".delete-link");
  
    deleteLinks.forEach(link => {
      link.addEventListener("click", async (e: MouseEvent) => {
        const target = e.currentTarget as HTMLButtonElement;
        const slug = target.dataset.slug;
        const title = target.dataset.title || slug;
  
        if (!slug) {
          console.error("Brak slug w atrybucie data-slug");
          alert("Błąd: Brak identyfikatora strony do usunięcia.");
          return;
        }
  
        const confirmed = confirm(`Czy na pewno chcesz usunąć stronę "${title}" (/ ${slug})? Tej operacji nie można cofnąć.`);
        if (!confirmed) return;
  
        const originalButtonText = target.innerHTML;
        target.disabled = true;
        target.innerHTML = '<i class="fas fa-spinner fa-spin mr-1.5"></i>Usuwanie...';
  
        try {
          const res = await fetch('/api/edytor/delete-page', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slug })
          });
  
          if (res.ok) {
            const listItem = target.closest('li');
            listItem?.classList.add('opacity-0', 'transition-opacity', 'duration-500');
            setTimeout(() => {
                listItem?.remove();
                if (document.querySelectorAll(".delete-link").length === 0) {
                    window.location.reload(); 
                }
            }, 500); 
          } else {
            const result = await res.json().catch(() => ({ message: "Wystąpił błąd przy usuwaniu strony." }));
            alert(`Błąd: ${result.message}`);
            target.disabled = false;
            target.innerHTML = originalButtonText;
          }
        } catch (error) {
          console.error(error);
          alert("Błąd sieci. Nie udało się usunąć strony.");
          target.disabled = false;
          target.innerHTML = originalButtonText;
        }
      });
    });
  });
</script>