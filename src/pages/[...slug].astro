---
import { getPageBySlug, type Page, type Comment as DbComment } from '@/lib/pagedb';
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { ProsemirrorViewer } from "@/components/prosemirror-viewer";
import CommentList from '@/components/CommentList.tsx'; // Twoja wersja komponentu [cite: user]
import CommentBox from '@/components/CommentBox.tsx';   // Twój komponent [cite: user]
import { SITE_TITLE } from '@/consts';
import { allSiteLocations } from '@/pages/regiony.astro';
import { allOrganizationCategories } from '@/lib/organizations';

const { slug } = Astro.params;
const user = Astro.locals.user;
const userId = user?.id;
const userRole = user?.role; // Używamy Astro.locals.user.role

if (!slug) {
  return Astro.redirect('/404?error=BrakSlug');
}

const page: Page | null = await getPageBySlug(slug);

if (!page) {
  return Astro.redirect(`/404?error=StronaNieZnaleziona&slug=${slug}`);
}

// Znajdź nazwy wyświetlane dla slugów
const regionName = page.regionSlug 
  ? allSiteLocations.find(loc => loc.slug === page.regionSlug)?.name 
  : null;
const organizationName = page.organizationSlug
  ? allOrganizationCategories.find(org => org.slug === page.organizationSlug)?.name
  : null;

// Przetwórz komentarze, aby przekazać je do komponentu React
// Upewnij się, że przekazujesz wszystkie potrzebne pola zdefiniowane w CommentForDisplay
const processedComments = page.comments ? page.comments.map(commentFromDb => ({
  ...commentFromDb, // Rozprzestrzenia wszystkie pola z DbComment (name, comment, createdAt, userRole etc.)
  _id: commentFromDb._id.toString(),
  userId: commentFromDb.userId.toString(),
})) : [];

// Funkcja pomocnicza do formatowania daty
function formatDate(date: Date | string | undefined): string {
  if (!date) return 'N/A';
  return new Date(date).toLocaleDateString('pl-PL', { 
    year: 'numeric', month: 'long', day: 'numeric', 
    hour: '2-digit', minute: '2-digit' 
  });
}
---
<BaseLayout title={`${page.title} - ${SITE_TITLE}`}>
  <Header slot="header" />

  <div class="container mx-auto px-4 py-8 sm:py-12">
    <article class="bg-white p-5 sm:p-6 md:p-8 rounded-xl shadow-xl">
      <header class="mb-6 pb-4 border-b border-gray-200">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-800 leading-tight">{page.title}</h1>
        <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
          <span class="text-gray-500">
            <i class="fas fa-calendar-alt mr-1.5 opacity-75"></i>
            Opublikowano: {formatDate(page.createdAt)}
          </span>
          {regionName && (
            <span class="text-red-600 font-semibold">
              <i class="fas fa-map-marker-alt mr-1.5 opacity-75"></i>Region: {regionName}
            </span>
          )}
          {organizationName && (
            <span class="text-blue-600 font-semibold">
              <i class="fas fa-sitemap mr-1.5 opacity-75"></i>Organizacja: {organizationName}
            </span>
          )}
        </div>
      </header>

      <!-- Wrapper dla treści i komentarzy, aby zachować spójną szerokość -->
      <div class="max-w-3xl mx-auto"> 
        
        <!-- Kontener na treść z Tiptap -->
        <div 
            class="prose prose-lg prose-p:text-gray-700 prose-headings:text-gray-800 prose-strong:text-gray-800 prose-a:text-red-600 hover:prose-a:text-red-700 max-w-none"
            id="tiptap-content-area"
        >
          <ProsemirrorViewer content={page.content} client:only="react" />
        </div>

        <!-- Sekcja Komentarzy -->
        <section aria-labelledby="comments-heading" class="mt-10 pt-6 border-t border-gray-300">
          <h2 id="comments-heading" class="text-2xl font-semibold text-gray-800 mb-6">
            Komentarze ({processedComments?.length || 0})
          </h2>
          
          <div class="space-y-6"> 
            <!-- Przekazujemy propsy zgodne z Twoim komponentem CommentList.tsx -->
            <CommentList 
              comments={processedComments} 
              postId={page._id.toString()} 
              role={userRole}  
              client:only="react" 
            />

            {userId ? (
              <CommentBox postId={page._id.toString()} userId={userId} client:only="react" />
            ) : (
              <div class="p-4 mt-6 border rounded-lg bg-gray-50 text-center">
                <p class="text-gray-700 text-sm">
                  <a href="/user/signin" class="text-red-600 hover:underline font-medium">Zaloguj się</a>, aby dodać komentarz.
                </p>
              </div>
            )}
          </div>
        </section>
      </div>
    </article>
  </div>

  <Footer slot="footer" />
</BaseLayout>

<!-- Skrypt do płynnego przewijania i podświetlania komentarza -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Odczytaj parametry i hash z adresu URL
    const urlParams = new URLSearchParams(window.location.search);
    const shouldHighlight = urlParams.get('highlight_comment') === 'true';
    const hash = window.location.hash;
    
    // Uruchom logikę TYLKO jeśli oba warunki są spełnione
    if (shouldHighlight && hash && hash.startsWith('#comment-')) {
      // Daj przeglądarce chwilę na renderowanie, zanim spróbujemy przewinąć
      setTimeout(() => {
        // Znajdź element komentarza po ID z hasha (usuwając #)
        const targetElement = document.getElementById(hash.substring(1));
        if (targetElement) {
          // Płynne przewinięcie do komentarza
          targetElement.scrollIntoView({
            behavior: 'smooth',
            block: 'center', // Wycentruj komentarz w widoku
          });

          // Dodaj tymczasowe podświetlenie, aby zwrócić uwagę użytkownika
          targetElement.classList.add('bg-red-50', 'ring-2', 'ring-red-300');
          
          // Usuń podświetlenie po 3.5 sekundach
          setTimeout(() => {
            targetElement.classList.remove('bg-red-50', 'ring-2', 'ring-red-300');
          }, 3500); 
        }
      }, 100); // Małe opóźnienie (100ms) dla pewności
    }
  });
</script>