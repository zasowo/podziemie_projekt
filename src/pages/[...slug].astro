---
import { getPageBySlug, type Page } from '@/lib/pagedb';
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { ProsemirrorViewer } from "@/components/prosemirror-viewer";
import CommentList from '@/components/CommentList';
import CommentBox from '@/components/CommentBox';
import { SITE_TITLE } from '@/consts';
import { allSiteLocations } from '@/pages/regiony.astro'; // Importuj listę lokalizacji
import '@/styles/_variables.scss';
import '@/styles/_keyframe-animations.scss';
const { slug } = Astro.params;
const userId = Astro.locals.user?.id;
const userRole = Astro.locals.role;

const page: Page | null = await getPageBySlug(slug!);

if (!page) {
  return Astro.redirect('/404'); 
}

// Znajdź nazwę regionu na podstawie page.regionSlug
const regionName = page.regionSlug 
  ? allSiteLocations.find(loc => loc.slug === page.regionSlug)?.name 
  : null;

const processedComments = page.comments ? page.comments.map(commentFromDb => ({
  ...commentFromDb, 
  _id: commentFromDb._id.toString(),
  userId: commentFromDb.userId.toString(),
})) : [];

function formatDate(date: Date | string | undefined): string {
  if (!date) return 'N/A';
  return new Date(date).toLocaleDateString('pl-PL', { 
    year: 'numeric', month: 'long', day: 'numeric', 
    hour: '2-digit', minute: '2-digit' 
  });
}
---
<BaseLayout title={`${page.title} - ${SITE_TITLE}`}>
  <Header slot="header" />

  <div class="container mx-auto px-4 py-8 sm:py-12">
    <article class="bg-white p-5 sm:p-6 md:p-8 rounded-xl shadow-xl">
      <header class="mb-6 pb-4 border-b border-gray-200">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-800 leading-tight">{page.title}</h1>
        <div class="mt-2 text-sm">
          <span class="text-gray-500">
            Opublikowano: {new Date(page.createdAt).toLocaleDateString('pl-PL', { year: 'numeric', month: 'long', day: 'numeric' })}
          </span>
          {/* Wyświetlanie regionu */}
          {regionName && (
            <span class="ml-3 pl-3 border-l border-gray-300 text-red-600 font-semibold">
              <i class="fas fa-map-marker-alt mr-1.5 opacity-75"></i>Region: {regionName}
            </span>
          )}
        </div>
      </header>

      <div class="max-w-3xl mx-auto"> 
        <div 
            class="prose prose-lg prose-p:text-gray-700 prose-headings:text-gray-800 prose-strong:text-gray-800 prose-a:text-red-600 hover:prose-a:text-red-700 max-w-none"
            id="tiptap-content-area"
        >
          <ProsemirrorViewer content={page.content} client:only="react" />
        </div>

        <section aria-labelledby="comments-heading" class="mt-10 pt-6 border-t border-gray-300">
          <h2 id="comments-heading" class="text-2xl font-semibold text-gray-800 mb-6">
            Komentarze ({processedComments?.length || 0})
          </h2>
          <div class="space-y-6"> 
            <CommentList comments={processedComments} postId={page._id.toString()} role={userRole} client:only="react" />
            {userId ? (
              <CommentBox postId={page._id.toString()} userId={userId} client:only="react" />
            ) : (
              <div class="p-4 mt-6 border rounded-lg bg-gray-50 text-center">
                <p class="text-gray-700 text-sm">
                  <a href="/user/signin" class="text-red-600 hover:underline font-medium">Zaloguj się</a>, aby dodać komentarz.
                </p>
              </div>
            )}
          </div>
        </section>
      </div>
    </article>
  </div>

  <Footer slot="footer" />
</BaseLayout>