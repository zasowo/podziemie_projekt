---
// src/pages/organizacje/[orgSlug].astro
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { getPagesByOrganization, type Page } from "@/lib/pagedb";
import { allOrganizationCategories } from '@/lib/organizations';
import { SITE_TITLE } from '@/consts';

// Funkcja generująca statyczne ścieżki dla każdej organizacji
export async function getStaticPaths() {
  return allOrganizationCategories.map(org => ({
    params: { orgSlug: org.slug },
  }));
}

const { orgSlug } = Astro.params;

// Znajdź pełne dane organizacji na podstawie sluga
const currentOrg = allOrganizationCategories.find(org => org.slug === orgSlug);
const orgName = currentOrg ? currentOrg.name : orgSlug; // Użyj sluga jako fallback

// Pobierz artykuły dla tej organizacji
const articlesInOrg: Page[] = orgSlug ? await getPagesByOrganization(orgSlug) : [];

function formatShortDate(date: Date | string | undefined): string {
  if (!date) return 'Brak daty';
  return new Date(date).toLocaleDateString('pl-PL', { day: '2-digit', month: 'long', year: 'numeric' });
}
---
<BaseLayout title={`Organizacja: ${orgName} - ${SITE_TITLE}`}>
  <Header slot="header" />

  <div class="container mx-auto px-4 py-8 sm:py-12">
    <header class="mb-10 text-center border-b border-gray-200 pb-6">
      <p class="text-md text-gray-500 mb-2">Publikacje powiązane z organizacją</p>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-800">
        {orgName}
      </h1>
      {currentOrg && (
        <a href={currentOrg.wikipediaLink} target="_blank" rel="noopener noreferrer" class="text-sm text-sky-600 hover:underline mt-2 inline-block">
          Przeczytaj więcej na Wikipedii <i class="fas fa-external-link-alt text-xs"></i>
        </a>
      )}
    </header>

    {articlesInOrg && articlesInOrg.length > 0 ? (
      <div class="space-y-6">
        {articlesInOrg.map(article => (
          <article class="bg-white p-5 sm:p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-200 ease-in-out">
            <a href={`/${article.slug}`} class="block group">
              <h2 class="text-xl sm:text-2xl font-semibold text-gray-800 group-hover:text-red-700 transition-colors mb-1.5 line-clamp-2" title={article.title}>
                {article.title}
              </h2>
            </a>
            <div class="text-xs text-gray-500 mb-3">
              <span>Opublikowano: {formatShortDate(article.createdAt)}</span>
              {article.comments && article.comments.length > 0 && (
                <>
                  <span class="mx-1.5">&bull;</span>
                  <span class="inline-flex items-center text-red-600 font-medium">
                    <i class="fas fa-comment mr-1 opacity-75"></i>
                    {article.comments.length}
                  </span>
                </>
              )}
            </div>
            <a href={`/${article.slug}`} class="text-sm text-red-600 hover:text-red-700 font-semibold group-hover:underline transition-colors">
              Czytaj dalej &rarr;
            </a>
          </article>
        ))}
      </div>
    ) : (
      <div class="text-center py-12">
        <i class="fas fa-folder-open text-6xl text-gray-300 mb-5"></i>
        <h2 class="text-xl font-semibold text-gray-700 mb-2">Brak Artykułów dla Organizacji: {orgName}</h2>
        <p class="text-gray-500 text-sm">Obecnie nie ma żadnych opublikowanych artykułów przypisanych do tej organizacji.</p>
        <a href="/regiony" class="mt-6 inline-block px-6 py-3 text-sm font-medium text-red-600 border border-red-600 rounded-lg hover:bg-red-50 transition">
            Zobacz inne kategorie
        </a>
      </div>
    )}
  </div>

  <Footer slot="footer" />
</BaseLayout>