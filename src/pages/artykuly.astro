---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { getAllPages, type Page } from "@/lib/pagedb"; //
import { SITE_TITLE } from '@/consts'; //

const allArticles: Page[] = await getAllPages(); // Pobierz wszystkie strony, domyślnie sortowane po dacie utworzenia (malejąco)

// Funkcja pomocnicza do formatowania daty
function formatShortDate(date: Date | string | undefined): string {
  if (!date) return 'Brak daty';
  return new Date(date).toLocaleDateString('pl-PL', { day: '2-digit', month: 'long', year: 'numeric' });
}

// Funkcja pomocnicza do tworzenia krótkiego fragmentu/zajawki (opcjonalnie)
// Na razie nie mamy pola excerpt, więc pominiemy dynamiczne tworzenie z Tiptap JSON
// function generateExcerpt(content: object, maxLength: number = 150): string {
//   // Logika do konwersji Tiptap JSON na tekst i przycięcia
//   // Dla uproszczenia, można dodać pole 'excerpt' do typu Page i wypełniać je przy zapisie
//   return "Kliknij, aby przeczytać więcej...";
// }
---
<BaseLayout title={`Artykuły - ${SITE_TITLE}`}>
  <Header slot="header" />

  <div class="container mx-auto px-4 py-8 sm:py-12">
    <header class="mb-10 text-center border-b border-gray-200 pb-6">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-800">Archiwum Publikacji</h1>
      <p class="text-gray-600 mt-2 text-lg">Przeglądaj wszystkie dostępne artykuły i materiały.</p>
    </header>

    {allArticles && allArticles.length > 0 ? (
      <div class="space-y-6">
        {allArticles.map(article => (
          <article class="bg-white p-5 sm:p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-200 ease-in-out">
            <a href={`/${article.slug}`} class="block group">
              <h2 class="text-xl sm:text-2xl font-semibold text-gray-800 group-hover:text-red-700 transition-colors mb-1.5 line-clamp-2" title={article.title}>
                {article.title}
              </h2>
            </a>
            <div class="text-xs text-gray-500 mb-3">
              <span>Opublikowano: {formatShortDate(article.createdAt)}</span>
              {article.comments && article.comments.length > 0 && (
                <>
                  <span class="mx-1.5">&bull;</span>
                  <span class="inline-flex items-center text-red-600 font-medium">
                    <i class="fas fa-comment mr-1 opacity-75"></i>
                    {article.comments.length}
                  </span>
                </>
              )}
            </div>
            {/* Opcjonalnie: Zajawka/opis, jeśli dodasz takie pole do 'Page' */}
            {/* <p class="text-sm text-gray-600 line-clamp-3 mb-3">
              {generateExcerpt(article.content)}
            </p> */}
            <a href={`/${article.slug}`} class="text-sm text-red-600 hover:text-red-700 font-semibold group-hover:underline transition-colors">
              Czytaj dalej &rarr;
            </a>
          </article>
        ))}
        {/* TODO: Dodać paginację, jeśli lista artykułów będzie długa */}
      </div>
    ) : (
      <div class="text-center py-12">
        <i class="fas fa-folder-open text-6xl text-gray-300 mb-5"></i>
        <h2 class="text-xl font-semibold text-gray-700 mb-2">Brak Artykułów</h2>
        <p class="text-gray-500 text-sm">Obecnie nie ma żadnych opublikowanych artykułów.</p>
         {Astro.locals.role === 'admin' && ( // Pokaż tylko adminom, jeśli edytorzy nie mogą dodawać z głównego panelu
          <a href="/edytor/dodaj" class="mt-6 inline-block px-6 py-3 text-sm font-medium text-white bg-red-600 rounded-lg hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition">
            Dodaj Pierwszy Artykuł
          </a>
        )}
      </div>
    )}
  </div>

  <Footer slot="footer" />
</BaseLayout>