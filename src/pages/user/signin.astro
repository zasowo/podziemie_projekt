---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE_TITLE } from '@/consts';

const contactEmail = `makdar@vp.pl`;
const emailSubject = encodeURIComponent(`Odzyskanie hasła - ${SITE_TITLE}`);
const gmailContactLink = `https://mail.google.com/mail/?view=cm&fs=1&to=${contactEmail}&su=${emailSubject}`

if (Astro.locals.user?.id) {
  return Astro.redirect('/');
}
---
<BaseLayout title={`Logowanie - ${SITE_TITLE}`}> {/* Logowanie */}
  <Header slot="header" />

  <div class="min-h-[calc(100vh-var(--header-height,0px)-var(--footer-height,0px))] flex flex-col items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8 hero-pattern">
    <div class="max-w-md w-full space-y-6 bg-white p-6 sm:p-8 rounded-xl shadow-xl">
      <div>
        <div class="flex items-center justify-center space-x-3 mb-5">
          <div class="w-10 h-10 sm:w-12 sm:h-12 bg-red-600 rounded-full flex items-center justify-center">
            <i class="fas fa-sign-in-alt text-white text-lg sm:text-xl"></i> {/* Changed icon */}
          </div>
          <h2 class="text-left text-xl sm:text-2xl font-bold text-gray-900">
            Zaloguj się do Podziemie 
        </div>
      </div>

      <div id="error" class="bg-red-100 border-l-4 border-red-500 text-red-700 p-3 text-sm rounded mb-4 hidden" role="alert">
        {/* Error message will be injected here */}
      </div>

      <form id="signin-form" class="space-y-4">
        <div>
          <label for="email-address" class="block text-xs font-medium text-gray-600 mb-0.5">Adres Email</label> {/* Email address */}
          <input id="email-address" name="email" type="email" autocomplete="email" required
                 class="block w-full text-sm border-gray-300 rounded-md shadow-sm focus:ring-red-500 focus:border-red-500 p-2.5"
                 placeholder="ty@example.com" />
        </div>
        <div>
          <label for="password" class="block text-xs font-medium text-gray-600 mb-0.5">Hasło</label> {/* Password */}
          <input id="password" name="password" type="password" autocomplete="current-password" required
                 class="block w-full text-sm border-gray-300 rounded-md shadow-sm focus:ring-red-500 focus:border-red-500 p-2.5"
                 placeholder="••••••••" />
        </div>
        <div class="flex items-center justify-center text-xs pt-1"> {/* Moved "Forgot password" to the right */}
          <a href={gmailContactLink} target="_blank" rel="noopener noreferrer" class="font-medium text-red-600 hover:text-red-500 hover:underline">
            Nie pamiętasz hasła? Skontaktuj się z administratorem
        </div>
        <div class="pt-2"> {/* Added padding top for button */}
          <button type="submit"
                  class="group w-full flex justify-center py-2.5 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition duration-150 ease-in-out">
            Zaloguj się {/* Sign in */}
          </button>
        </div>
      </form>

            </div>
          </>
      <p class="mt-5 text-center text-xs text-gray-600">
        Nie masz konta? {/* Don't have an account? */}
        <a href="/user/signup" class="font-medium text-red-600 hover:text-red-500 hover:underline ml-1">
          Zarejestruj się {/* Sign up */}
        </a>
      </p>
    </div>
  </div>

  <Footer slot="footer" />
  <script>
    import { authClient } from '@/auth-client';

    const signinForm = document.getElementById('signin-form');
    const errorDiv = document.getElementById('error');

    signinForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (errorDiv) {
          errorDiv.textContent = '';
          errorDiv.classList.add('hidden');
      }

      const form = event.target as HTMLFormElement;
      const email = (form.elements.namedItem('email') as HTMLInputElement)?.value;
      const password = (form.elements.namedItem('password') as HTMLInputElement)?.value;

      if (!email || !password) {
         if (errorDiv) {
            errorDiv.textContent = 'Proszę podać email i hasło.'; // Please enter both email and password.
            errorDiv.classList.remove('hidden');
        }
        return;
      }

      const result = await authClient.signIn.email({ email, password });

      if (result && result.error) {
        if (errorDiv) {
            errorDiv.textContent = `Błąd: ${result.error.message || 'Nieznany błąd logowania.'}`; // Error: An unknown login error occurred.
            errorDiv.classList.remove('hidden');
        }
      } else if (result && !result.error) {
        window.location.href = '/'; 
      } else {
        if (errorDiv) {
            errorDiv.textContent = 'Wystąpił nieoczekiwany błąd podczas logowania.'; // An unexpected error occurred during sign in.
            errorDiv.classList.remove('hidden');
        }
      }
    });
  </script>
</BaseLayout>