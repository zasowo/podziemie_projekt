---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE_TITLE } from '@/consts';

// Redirect if already logged in
if (Astro.locals.user?.id) {
  return Astro.redirect('/');
}
---
<BaseLayout title={`Sign In - ${SITE_TITLE}`}>
  <Header slot="header" />

  <div class="min-h-[calc(100vh-var(--header-height,0px)-var(--footer-height,0px))] flex flex-col items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8 hero-pattern">
    <div class="max-w-md w-full space-y-8 bg-white p-8 sm:p-10 rounded-xl shadow-xl">
      <div>
        <div class="flex items-center justify-center space-x-3 mb-6">
          <div class="w-12 h-12 bg-red-600 rounded-full flex items-center justify-center">
            <i class="fas fa-landmark text-white text-xl"></i>
          </div>
          <h2 class="text-center text-2xl sm:text-3xl font-bold text-gray-900">
            Sign in to Patrimonium
          </h2>
        </div>
      </div>

      {/* This div will display errors from the script */}
      <div id="error" class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 mb-6 hidden" role="alert">
        {/* Error message will be injected here by the script */}
      </div>

      <form id="signin-form" class="mt-8 space-y-6"> {/* Removed action and method */}
        <div class="rounded-md shadow-sm space-y-4">
          <div>
            <label for="email-address" class="block text-sm font-medium text-gray-700 mb-1">Email address</label>
            <input id="email-address" name="email" type="email" autocomplete="email" required
                   class="appearance-none relative block w-full px-4 py-3 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-md focus:outline-none focus:ring-red-500 focus:border-red-500 sm:text-sm"
                   placeholder="you@example.com" />
          </div>
          <div>
            <label for="password" class="block text-sm font-medium text-gray-700 mb-1">Password</label>
            <input id="password" name="password" type="password" autocomplete="current-password" required
                   class="appearance-none relative block w-full px-4 py-3 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-md focus:outline-none focus:ring-red-500 focus:border-red-500 sm:text-sm"
                   placeholder="••••••••" />
          </div>
        </div>

        <div class="flex items-center justify-between text-sm">
          <div class="flex items-center">
            {/* Remember me functionality would typically be handled by better-auth session settings */}
            {/* <input id="remember-me" name="remember-me" type="checkbox"
                   class="h-4 w-4 text-red-600 focus:ring-red-500 border-gray-300 rounded" />
            <label for="remember-me" class="ml-2 block text-gray-900">
              Remember me
            </label> */}
          </div>
          <a href="#" class="font-medium text-red-600 hover:text-red-500 hover:underline">
            Forgot your password?
          </a>
        </div>

        <div>
          <button type="submit"
                  class="group relative w-full flex justify-center py-3 px-4 border border-transparent text-base font-medium rounded-md text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition duration-150 ease-in-out">
            Sign in
          </button>
        </div>
      </form>
       <p class="mt-6 text-center text-sm text-gray-600">
        Don't have an account?
        <a href="/user/signup" class="font-medium text-red-600 hover:text-red-500 hover:underline ml-1">
          Sign up
        </a>
      </p>
    </div>
  </div>

  <Footer slot="footer" />
  <script>
    import { authClient } from '@/auth-client'; // Ensure this path is correct

    const signinForm = document.getElementById('signin-form');
    const errorDiv = document.getElementById('error');

    signinForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (errorDiv) errorDiv.classList.add('hidden'); // Hide previous errors

      const form = event.target as HTMLFormElement;
      const email = (form.elements.namedItem('email') as HTMLInputElement)?.value;
      const password = (form.elements.namedItem('password') as HTMLInputElement)?.value;

      if (!email || !password) {
         if (errorDiv) {
            errorDiv.innerHTML = 'Please enter both email and password.';
            errorDiv.classList.remove('hidden');
        }
        return;
      }

      const result = await authClient.signIn.email({
        email,
        password,
      });

      if (result && result.error) {
        if (errorDiv) {
            errorDiv.innerHTML = `Error: ${result.error.message || 'An unknown error occurred.'}`;
            errorDiv.classList.remove('hidden');
        }
      } else if (result && !result.error) {
        // Successful sign-in
        window.location.href = '/'; // Redirect to homepage or dashboard
      } else {
        // Handle unexpected result structure
        if (errorDiv) {
            errorDiv.innerHTML = 'An unexpected error occurred during sign in.';
            errorDiv.classList.remove('hidden');
        }
      }
    });
  </script>
</BaseLayout>