---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro"; 
import Footer from "@/components/Footer.astro"; 
import { SITE_TITLE } from "@/consts";
---

<BaseLayout title={`404 - Nie Znaleziono Strony - ${SITE_TITLE}`}>
  <Header slot="header" />
  <main class="flex-grow"> 
    <div class="container mx-auto px-4 py-10 sm:py-16 text-center flex flex-col items-center justify-center">     
      <div class="max-w-md"> 
        <div class="text-7xl sm:text-8xl font-bold text-red-500 mb-3">404</div> 
        <h1 class="text-2xl sm:text-3xl font-bold text-gray-800 mb-2"> 
          Ups! Strona Nie Znaleziona.
        </h1>  
        <p class="text-gray-600 mb-6 text-sm sm:text-base leading-relaxed"> 
          Przepraszamy, strona, której szukasz, nie istnieje, została przeniesiona lub jest tymczasowo niedostępna.
        </p>
        <div class="flex flex-col sm:flex-row justify-center items-center gap-4">
          <a 
            href="/" 
            class="px-6 py-2.5 bg-red-600 text-white rounded-md hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 transition font-semibold text-base shadow-md hover:shadow-lg transform hover:scale-105" 
          >
            <i class="fas fa-home mr-1.5"></i>Powrót do Strony Głównej 
          </a>
        </div>
      </div>

    </div>
  </main>

  <Footer slot="footer" />
</BaseLayout>