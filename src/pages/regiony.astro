---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE_TITLE } from '@/consts';
import { allOrganizationCategories } from '@/lib/organizations'; //

// Lista lokalizacji geograficznych (wcześniej w tym pliku, teraz może być importowana, ale dla jasności zostaje tutaj)
export const allSiteLocations = [
  { name: "Dolnośląskie", slug: "dolnoslaskie", description: "Zamki, pałace i tajemnicze miejsca Dolnego Śląska.", iconClass: "fas fa-chess-rook" },
  { name: "Lubelskie", slug: "lubelskie", description: "Malownicze Roztocze, renesansowe Zamość i Lublin.", iconClass: "fas fa-leaf" },
  { name: "Łódzkie", slug: "lodzkie", description: "Postindustrialne dziedzictwo Łodzi i centralna Polska.", iconClass: "fas fa-industry" },
  { name: "Małopolskie", slug: "malopolskie", description: "Zabytki Krakowa, Tatry i bogata historia regionu.", iconClass: "fas fa-landmark" },
  { name: "Mazowieckie", slug: "mazowieckie", description: "Warszawa i okolice – serce Polski pełne historycznych śladów.", iconClass: "fas fa-monument" },
  { name: "Pomorskie", slug: "pomorskie", description: "Bałtyckie plaże, Trójmiasto i kaszubskie tradycje.", iconClass: "fas fa-ship" },
  { name: "Śląskie", slug: "slaskie", description: "Odkryj dziedzictwo przemysłowe i kulturowe Górnego Śląska.", iconClass: "fas fa-cogs" },
  { name: "Częstochowa", slug: "czestochowa", description: "Jasna Góra i duchowe serce Polski.", iconClass: "fas fa-church" },
  { name: "Wielkopolskie", slug: "wielkopolskie", description: "Kolebka państwa polskiego i dynamiczny Poznań.", iconClass: "fas fa-wheat-awn" },
  { name: "Zachodniopomorskie", slug: "zachodniopomorskie", description: "Wybrzeże Bałtyku, porty i wyspy.", iconClass: "fas fa-anchor" }
];


// --- NOWA LOGIKA ŁĄCZENIA I SORTOWANIA KATEGORII ---

// 1. Połącz obie listy (regiony i organizacje) w jedną
const unifiedCategories = [
  // Mapuj regiony, dodając typ
  ...allSiteLocations.map(location => ({
    ...location,
    type: 'region',
    typeDisplay: 'Region' // Tekst do wyświetlenia
  })),
  // Mapuj organizacje, dodając typ i domyślną ikonę
  ...allOrganizationCategories.map(org => ({
    ...org,
    type: 'organizacje', // typ zgodny z URL (np. /organizacje/slug)
    iconClass: 'fas fa-users-cog', // Wspólna ikona dla wszystkich organizacji
    typeDisplay: 'Organizacja' // Tekst do wyświetlenia
  }))
];

// 2. Posortuj połączoną listę alfabetycznie po nazwie
const sortedCategories = unifiedCategories.sort((a, b) => a.name.localeCompare(b.name, 'pl'));
---
<BaseLayout title={`Kategorie - ${SITE_TITLE}`}> 
  <Header slot="header" />

  <div class="container mx-auto px-4 py-8 sm:py-12">
    <header class="mb-10 text-center">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-800">Przeglądaj Publikacje według Kategorii</h1>
      <p class="text-gray-600 mt-2 text-lg">Wybierz region, miejscowość lub organizację, aby zobaczyć powiązane materiały.</p>
    </header>

    {sortedCategories && sortedCategories.length > 0 ? (
      // Jedna siatka (grid) dla wszystkich połączonych kafelków
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 md:gap-8">
        {sortedCategories.map(category => {
          // Dynamiczne tworzenie linku na podstawie typu
          const linkHref = `/${category.type}/${category.slug}`;
          // Warunkowa klasa koloru akcentu
          const hoverColorClass = category.type === 'region' ? 'hover:text-red-700 focus:ring-red-500' : 'hover:text-blue-700 focus:ring-blue-500';
          const iconColorClass = category.type === 'region' ? 'text-red-500 group-hover:text-red-600' : 'text-blue-500 group-hover:text-blue-600';
          
          return (
            <a 
              href={linkHref} 
              class={`group block bg-white p-6 rounded-xl shadow-lg hover:shadow-2xl focus:outline-none focus:ring-2 focus:ring-offset-2 transition-all duration-300 ease-in-out transform hover:-translate-y-1.5 hover:scale-105 ${hoverColorClass}`}
              title={`Zobacz publikacje dla: ${category.name}`}
            >
              <div class="flex flex-col items-center text-center">
                <div class={`mb-4 transition-colors duration-300 ${iconColorClass}`}>
                  <i class={`${category.iconClass || 'fas fa-folder-open'} text-5xl`}></i>
                </div>
                <h2 class={`text-xl font-semibold text-gray-800 transition-colors duration-300 ${hoverColorClass}`}>
                  {category.name}
                </h2>
                {/* Opcjonalny opis typu kategorii */}
                <p class="text-xs text-gray-400 mt-1 capitalize">{category.typeDisplay}</p>
              </div>
            </a>
          );
        })}
      </div>
    ) : (
      <div class="text-center py-12">
        <i class="fas fa-map-signs text-6xl text-gray-300 mb-5"></i>
        <h2 class="text-xl font-semibold text-gray-700 mb-2">Brak Zdefiniowanych Kategorii</h2>
        <p class="text-gray-500 text-sm">Obecnie nie ma dostępnych kategorii do przeglądania.</p>
      </div>
    )}
    
    <div class="mt-16 text-center">
        <a href="/" class="px-6 py-3 border border-gray-300 text-gray-700 rounded-md hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-400 focus:ring-offset-2 transition font-medium text-sm">
            &larr; Powrót do Strony Głównej
        </a>
    </div>
  </div>

  <Footer slot="footer" />
</BaseLayout>